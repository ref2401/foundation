{
    "version": 4,
    "configurations": [
        {
            "name": "Win32",
            "compilerPath": "cl.exe",
            "compilerArgs": [
                "/std:c++20",
                "/EHsc",
                "/permissive-",
                "/utf-8",
                "/ifcSearchDir",
                "${workspaceFolder}/bin/ifc"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-msvc-x64",
            "includePath": [
                "${workspaceFolder}/src"
            ],
            "defines": [
                "_DEBUG",
                "_UNICODE",
                "UNICODE"
            ]
        }
    ]
}