{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Unittests (Debug)",
            "type": "shell",
            "command": "powershell ",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/build_unittests.ps1",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "compiler: cl.exe"
        },

        {
            "label": "Rebuild Unittests (Debug)",
            "type": "shell",
            "command": "powershell ",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/build_unittests.ps1",
                "Debug",
                "-Clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "compiler: cl.exe"
        },

        {
            "label": "Build Unittests (Release)",
            "type": "shell",
            "command": "powershell ",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/build_unittests.ps1",
                "Release",
                "-Clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "compiler: cl.exe"
        },
    ]
}