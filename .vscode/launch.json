{
    "version": "0.2.0",
    "configurations": [
        {
            // Runs the launch target in the variant (Debug or Release) picked
            // with "CMake: Select Variant"; CMake Tools builds it first.
            "name": "unittests",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${command:cmake.getLaunchTargetDirectory}",
            "environment": [],
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
            "requireExactSource": true,
        },
    ]
}
